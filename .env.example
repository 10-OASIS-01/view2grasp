# Generic OpenAI-compatible defaults. For GLM use .env.glm.example instead.
# Copy to .env, edit locally, and load explicitly with: uv run --env-file .env ...
VLM_PROVIDER=openai-compatible
VLM_BASE_URL=http://127.0.0.1:8318/v1
VLM_API_KEY=local
VLM_MODEL=gt-6-as-a
# Optional; the generic provider sends none of these options by default.
# For the verified GLM defaults, use .env.glm.example.
# VLM_MAX_TOKENS=4096
# VLM_THINKING=enabled
# VLM_REASONING_EFFORT=low
# VLM_TIMEOUT_SECONDS=120
