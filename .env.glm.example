# Copy to .env, fill in your key locally, and run with: uv run --env-file .env ...
VLM_PROVIDER=glm
ZHIPU_API_KEY=
# Choose a vision model that supports image_url with PNG Base64.
VLM_MODEL=glm-5.3-flashx
VLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VLM_THINKING=enabled
VLM_REASONING_EFFORT=low
VLM_MAX_TOKENS=4096
VLM_TIMEOUT_SECONDS=120
